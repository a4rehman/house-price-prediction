# Customer Churn Intelligence environment configuration
# Copy to `.env` and adjust as needed.

# --- Paths ------------------------------------------------------------
# (all default to the project-relative layout; override only if required)
# DATA_RAW_DIR=./data/raw
# DATA_PROCESSED_DIR=./data/processed
# ARTIFACTS_DIR=./artifacts

# --- Data source -------------------------------------------------------
# TARGET_COLUMN=Churn

# --- Data quality ------------------------------------------------------
# NA_VALUES=['?','NA','N/A','null']
# OUTLIER_IQR_MULTIPLIER=1.5
# CAP_EXTREME_LOT_AREA=100000

# --- Modelling ---------------------------------------------------------
# RANDOM_STATE=42
# CV_FOLDS=5
# TEST_SIZE=0.2
# N_TRIALS=30
# USE_LOG_TARGET=true

# --- Model registry ----------------------------------------------------
# REGISTERED_MODEL_NAME=customer_churn_predictor
# MODEL_URI=

# --- Logging -----------------------------------------------------------
# LOG_LEVEL=INFO
# LOG_FILE=logs/churn.log

# --- API ---------------------------------------------------------------
# API_HOST=0.0.0.0
# API_PORT=8000
# MAX_BATCH_SIZE=10000

# --- Dashboard ---------------------------------------------------------
# DASHBOARD_HOST=0.0.0.0
# DASHBOARD_PORT=8501
API_KEY=replace-with-a-long-random-production-secret
